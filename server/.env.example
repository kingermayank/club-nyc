# Copy to server/.env and fill in. Everything is optional for local play (guest accounts work without OAuth).

# Where players reach the game. In development Vite (5173) proxies /api and /ws to this server.
PUBLIC_URL=http://localhost:5173
PORT=8787

# --- Sign in with Google ---
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with X ---
# developer.x.com → Projects & Apps → your app → User authentication settings (OAuth 2.0, Web App)
# Callback URI: http://localhost:5173/api/auth/x/callback   Scopes used: users.read tweet.read
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- The landing page and policy pages ---
# Filled in wherever the pages say [CONTACT EMAIL] / [COMPANY NAME]. CONTACT_EMAIL is also shown to banned players.
CONTACT_EMAIL=
COMPANY_NAME=
# The terms' governing law and courts (a US state, e.g. New York), and a postal address for legal notices.
GOVERNING_STATE=
MAILING_ADDRESS=
# Where the "Join the Discord" buttons go (via /discord, so you can change it here any time).
# Use a NEVER-EXPIRING invite: Discord → server menu → Invite People → Edit invite link → Expire After: Never.
DISCORD_INVITE_URL=

# Gameplay / scaling knobs
ROOM_CAP=60          # players per room instance (more spill into "Times Square 2", …)
TICK_MS=66           # outbound batch interval (~15 Hz)
ALLOW_GUESTS=true    # instant play without an account
NPC_BASELINE=true    # neighborhood standings include the NPC locals' points

# DB_PATH=./data/club-nyc.db

# Production: NODE_ENV=production turns off dev conveniences (metrics endpoint, loopback rate-limit bypass).
# Behind a load balancer / reverse proxy, trust its X-Forwarded-For so rate limits see real client IPs.
# NODE_ENV=production
# TRUST_PROXY=true
