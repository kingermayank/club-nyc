# Copy to server/.env and fill in. Everything is optional for local play (guest accounts work without OAuth).
# What each sign-in needs and where to get it: docs/sign-in-setup.md

# Where players reach the game. In development Vite (5173) proxies /api and /ws to this server.
# (If your Vite runs on 5174 because another project has 5173, use http://localhost:5174 here and in the consoles.)
PUBLIC_URL=http://localhost:5173
PORT=8787

# --- The launch: Coming Soon + waitlist, or open ---
# waitlist = the landing page takes emails ("Join the Waitlist") and /play shows a Coming Soon page.
# open     = everyone can play. Unset: production is waitlist, development is open.
LAUNCH_MODE=
# Testers open /play?preview=<this> once per browser to get into the city while it's in waitlist mode
# (/play?preview=off forgets it). Make one with: openssl rand -hex 12
PREVIEW_CODE=
# false = no confirmation email for new waitlist signups (by default they confirm when email is set up)
# WAITLIST_CONFIRM=true
# The landing page shows how many people are in line only from this many (honest numbers, never tiny ones)
# WAITLIST_PUBLIC_MIN=100

# --- Email (sign-in links, waitlist confirmations, the launch email) via Resend ---
# resend.com → verify a sending domain (DKIM + SPF records) → API Keys → "Sending access"
# Unset in development: every email is printed to the server log instead, links included.
RESEND_API_KEY=
# An address on the verified domain, e.g. Club NYC <hello@mail.yourdomain.com>
EMAIL_FROM=
# Optional: where replies go (defaults to CONTACT_EMAIL)
EMAIL_REPLY_TO=
# Optional: signs the unsubscribe links in waitlist emails (otherwise made once and kept next to the database)
# EMAIL_LINK_SECRET=

# --- Sign in with Google ---
# console.cloud.google.com → Google Auth Platform → Clients → Web application
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with X ---
# developer.x.com → your app → User authentication settings (OAuth 2.0, Web App). X bills per use (credits).
# Callback URI: http://localhost:5173/api/auth/x/callback   Scopes used: users.read tweet.read
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Sign in with Discord ---
# discord.com/developers/applications → your app → OAuth2 (Client ID, Reset Secret)
# Redirect: http://localhost:5173/api/auth/discord/callback   Scope used: identify
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- The landing page and policy pages ---
# Filled in wherever the pages say [CONTACT EMAIL] / [COMPANY NAME]. CONTACT_EMAIL is also shown to banned players.
CONTACT_EMAIL=
COMPANY_NAME=
# The terms' governing law and courts (a US state, e.g. New York), and a postal address for legal notices
# (also printed at the bottom of waitlist emails, as anti-spam laws expect).
GOVERNING_STATE=
MAILING_ADDRESS=
# Where the "Join the Discord" buttons go (via /discord, so you can change it here any time).
# Use a NEVER-EXPIRING invite: Discord → server menu → Invite People → Edit invite link → Expire After: Never.
DISCORD_INVITE_URL=

# Gameplay / scaling knobs
ROOM_CAP=60          # players per room instance (more spill into "Times Square 2", …)
TICK_MS=66           # outbound batch interval (~15 Hz)
ALLOW_GUESTS=true    # instant play without an account
NPC_BASELINE=true    # neighborhood standings include the NPC locals' points

# DB_PATH=./data/club-nyc.db

# Production: NODE_ENV=production turns off dev conveniences (metrics endpoint, loopback rate-limit bypass).
# Behind a load balancer / reverse proxy, trust its X-Forwarded-For so rate limits see real client IPs.
# NODE_ENV=production
# TRUST_PROXY=true
