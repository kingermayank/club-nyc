node_modules/
.venv/
dist/
.DS_Store
__pycache__/
*.pyc
*.log

# never commit: local databases, secrets, huge scratch files (GitHub rejects files over 100 MB)
scratch/
server/data/
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
*.db-journal
.claude/settings.local.json

# generated, and too big for git: test screenshots and output (re-run the tools to make them again)
tools/out/
docs/flow/
# art-pipeline originals and previews (the game ships the processed art; see .dockerignore)
app/public/art/raw/
app/public/art/preview/

# design-lab clips (npm --prefix video run clips makes them again)
app/lab/clips/

# test photos for the photo-match lab (app/lab/match.html)
app/lab/_faces/

# licensed sound originals (tools/sfx_build.py makes app/public/sfx from them)
tools/sfx_raw/

# playtest bot output (screenshots, reports)
tools/playtest/out/

# the full-frame source animations for the subway train (38 MB; tools/subway_train.py cuts the game clips from them)
app/public/art/raw/train/*.mp4
