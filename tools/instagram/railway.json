{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["/tools/instagram/**"]
  },
  "deploy": {
    "startCommand": "node publish.mjs --live --remote --from=2026-11-01 --grace=6",
    "cronSchedule": "*/10 * * * *",
    "restartPolicyType": "NEVER"
  }
}
