{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "club-nyc",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "club-nyc-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "club-nyc-qa",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "tools/qa_stack.sh"
      ],
      "port": 5197
    },
    {
      "name": "repo-files",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8811", "--bind", "127.0.0.1"],
      "port": 8811
    }
  ]
}
